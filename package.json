{
  "name": "gtfo-datablock-studio",
  "version": "0.3.2",
  "private": true,
  "description": "Validator and typed editor for GTFO (MTFO) datablock JSON rundowns",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p packages/core && tsc --noEmit -p packages/schema && tsc --noEmit -p packages/cli",
    "schema:build": "tsx packages/schema/build/main.ts",
    "validate": "tsx packages/cli/src/validate.ts",
    "format": "prettier --write \"packages/**/*.{ts,tsx,json}\""
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
